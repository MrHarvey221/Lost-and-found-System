# Relative SQLite paths resolve against this project, not your terminal folder.
DATABASE_URL=sqlite:///./lost_and_found.db
DATA_DIR=./data
# Leave blank to generate and persist a random key in DATA_DIR/session.key.
# Or set a random value of at least 32 characters. Never commit the real .env.
SESSION_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=false
MATCH_THRESHOLD=45
SEMANTIC_MODE=auto
SEMANTIC_MODEL_DIR=./models/all-MiniLM-L6-v2
# Synthetic data is opt-in through manage.py seed-demo and RUN_DEMO.cmd.
DEMO_MODE=false
